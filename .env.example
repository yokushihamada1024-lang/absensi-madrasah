# Salin ke .env (JANGAN commit .env). Nilai di bawah hanya contoh.

# dev | production
ENV=dev
# memory | postgres   (memory dilarang saat ENV=production)
REPO_BACKEND=memory

# Rahasia — buat nilai acak panjang, mis: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=ganti-dengan-nilai-acak-panjang
QR_MASTER_KEY=ganti-dengan-nilai-acak-panjang-lain

# Origin persis kedua Static Site, dipisah koma (tanpa garis miring di akhir)
ALLOWED_ORIGINS=http://localhost:8001,http://localhost:8002

# Supabase Postgres (wajib jika REPO_BACKEND=postgres).
# Supabase Dashboard → Connect → "Session pooler" (IPv4, port 5432). Rahasia — isi di Render, jangan commit.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

TZ=Asia/Jakarta

# Hanya untuk pengembangan lokal (ENV=dev). Aplikasi menolak start jika aktif di produksi.
DEV_FAKE_LOCATION=0

# Dipakai saat build Static Site (non-rahasia)
API_BASE_URL=http://localhost:8000
